# Copy to .env on the VPS and fill in. Never commit .env.
CLIPZ_DB_PATH=data/clipz.db
CLIPZ_COUNTRY=US
# Whop user OAuth token with bounty:basic:read (and bounty:submission:create for Phase 5)
WHOP_TOKEN=
# Anthropic API key for the rule reader
ANTHROPIC_API_KEY=
# Phase 2: Telegram alerts. Token from @BotFather; chat id from `python -m clipz.notify whoami`.
# Leave empty for a dry run that prints alerts instead of sending.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Clipping pipeline ---
# Free Twitch developer app: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Only if Kick blocks the server's IP, e.g. http://user:pass@host:port
KICK_PROXY=
# Where chat logs and segments go (defaults to the database's folder)
CLIPZ_DATA_DIR=
TWITCH_DOWNLOADER_CLI=TwitchDownloaderCLI
# Phase 2: OpenShorts reads this for hooks, captions and layout (free tier is fine)
GEMINI_API_KEY=
# Defaults to the openshorts service in docker-compose
OPENSHORTS_URL=
# Phase 5
UPLOAD_POST_API_KEY=
